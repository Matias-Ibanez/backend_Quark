# Copiar a .env. Nunca subir claves reales al repositorio.
DEEPSEEK_API_KEY=
# Para el servidor, generar un valor aleatorio largo. Vacío usa la clave local de desarrollo.
HERMES_API_KEY=
STUDIO_PORT=8010
# Origen público exacto, sin barra final; dejar vacío para uso local.
PUBLIC_APP_ORIGIN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_API_VERSION=v22.0
# URL pública base de los medios para publicar en Instagram; opcional por ahora.
PUBLIC_MEDIA_BASE_URL=

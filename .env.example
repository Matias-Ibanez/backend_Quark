# Copiar a .env. Nunca subir claves reales al repositorio.
DEEPSEEK_API_KEY=
# Fotogramas renderizados a la vez en Hermes (1–4); empezar con 2 en el i3.
QUARK_REMOTION_CONCURRENCY=2
# Solo posts/carruseles: off acelera; on conserva el razonamiento predeterminado de Hermes.
QUARK_POST_REASONING=off
# Para el servidor, generar un valor aleatorio largo. Vacío usa la clave local de desarrollo.
HERMES_API_KEY=
# Para shorts automáticos: clave gratuita desde https://www.pexels.com/api/ (una vez por despliegue).
PEXELS_API_KEY=
# Opcional: clave privada entre studio y MoneyPrinterTurbo en la red Docker.
SHORTS_API_KEY=
STUDIO_PORT=8011
# Puerto del frontend separado (landing-quark), usado para validar el origen local.
FRONTEND_PORT=8010
# Origen público exacto, sin barra final; dejar vacío para uso local.
# En servidor debe ser HTTPS: activa cookies Secure y __Host- para la cuenta admin.
# La contraseña se configura por consola; ver AUTENTICACION.md. No va en este archivo.
PUBLIC_APP_ORIGIN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_API_VERSION=v22.0
# URL pública base de los medios para publicar en Instagram; opcional por ahora.
PUBLIC_MEDIA_BASE_URL=
